# Cell 1 - Imports
from pgmpy.models import BayesianModel, LinearGaussianBayesianNetwork
from pgmpy.factors.discrete import TabularCPD
from pgmpy.factors.continuous import LinearGaussianCPD
from pgmpy.inference import VariableElimination
from pgmpy.visualization import DAG

# Cell 2 - Introduction (Markdown)
"""
# CPD Tutorial: TabularCPD and LinearGaussianCPD in pgmpy

This notebook provides a quick overview of how to define Conditional Probability Distributions (CPDs) using pgmpy. We'll cover:

- TabularCPD for discrete variables
- LinearGaussianCPD for continuous variables
"""

# Cell 3 - TabularCPD Example
"""
## Example: TabularCPD (Discrete Variables)

We'll create a simple model: A → B
- A: Binary (0 or 1)
- B: Depends on A
"""

model = BayesianModel([('A', 'B')])

cpd_a = TabularCPD(variable='A', variable_card=2, values=[[0.6], [0.4]])

cpd_b = TabularCPD(variable='B', variable_card=2,
                   values=[[0.8, 0.3],  # P(B=0 | A)
                           [0.2, 0.7]], # P(B=1 | A)
                   evidence=['A'],
                   evidence_card=[2])

model.add_cpds(cpd_a, cpd_b)

print("CPDs added to model:")
for cpd in model.get_cpds():
    print(cpd)

# Cell 4 - Visualizing the DAG
"""
## DAG Visualization
"""

dag = DAG(model)
dag.draw()

# Cell 5 - LinearGaussianCPD Example
"""
## Example: LinearGaussianCPD (Continuous Variables)

We'll create a continuous model: X → Y
"""

from pgmpy.models import LinearGaussianBayesianNetwork

lg_model = LinearGaussianBayesianNetwork([('X', 'Y')])

# Define CPDs
cpd_x = LinearGaussianCPD('X', [0], 1)  # P(X) = N(0, 1)
cpd_y = LinearGaussianCPD('Y', [1], 2, ['X'])  # P(Y | X) = N(X, 2)

lg_model.add_cpds(cpd_x, cpd_y)

print("\nLinear Gaussian CPDs:")
for cpd in lg_model.get_cpds():
    print(cpd)
